~ end_date
if GameManager.get_affection("sea_monster") <= 0:
	=> horror_exit
elif GameManager.get_affection("sea_monster") >= 70:
	do GameManager.set_expression("blush")
	Sienna: *Gasps as ear-fins flare pink, handing you a glowing bioluminescent sea pebble.*
	Sienna: HERE! Take my favorite glowing sea-stone! You HAVE to come on another date with me, okay?!
