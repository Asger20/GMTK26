	do GameManager.set_expression("angry")
	Sienna: *Yawns loudly, crossing her webbed arms.*
	Sienna: Wow, this date was a total snooze fest. See ya around.
	Sienna: *Walks away without looking back.*
else:
	do GameManager.set_expression("happy")
	Sienna: *High-fives with webbed claws.*
	Sienna: THAT WAS SO FUN! Thanks for hanging out! See ya next time!

do GameManager.complete_current_date()
=> END

~ horror_exit
do GameManager.set_expression("scary")
