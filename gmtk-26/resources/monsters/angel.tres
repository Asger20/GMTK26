[resource]
script = ExtResource("1_monster")
id = "angel"
display_name = "Isaac"
species = "Biblical Angel"
dialogue_resource = ExtResource("2_dialogue")
species_lore = PackedStringArray("Seraphim Geometrica / Biblical Angel. Native to high-frequency celestial spheres, pristine marble sanctuaries, and ordered sanctums.", "They view the cosmos as a flawless mathematical equation. Perfection, symmetry, and golden-ratio alignment are sacred physical laws.", "Geometric Alignment & Asymmetry Distress: Nervous system bound to environmental order. Crooked frames or clutter induce physical nausea and resonance decay.", "Harmonic Frequency Resonance: Speaks in multi-harmonic chords. Calming metallic chime tones shift to sharp dissonant hums under stress.", "Luminance & Ocular Scanning: Emits subtle aura; multi-pupillary eyes scan space calculating 90-degree vector angles in real-time.", "The Symmetry Twitch: Misaligned objects trigger an involuntary physical urge to realign them precisely to 90 degrees.", "Dissonant Chaos Revulsion: Random noise, speech interruptions, or chaotic clutter induce immediate vocal buzzing and physical rigidity.", "Golden-Ratio Tactile Tracing: Under stress or affection, fingers subconsciously trace perfect circles, triangles, and parallel lines on surfaces.")
min_affection_for_match = 80
