[resource]
script = ExtResource("1_monster")
id = "angel"
display_name = "Isaac"
species = "Biblical Angel"
portrait_texture = ExtResource("4_normal")
portrait_y_offset = -140.0
expressions = {
"angry": ExtResource("5_angry"),
"blush": ExtResource("6_blush"),
"happy": ExtResource("7_happy"),
"normal": ExtResource("4_normal"),
"scary": ExtResource("8_scary")
}
dialogue_resource = ExtResource("2_dialogue")
dialogue_voice = ExtResource("3_voice")
species_lore = PackedStringArray("Seraphim Geometrica / Biblical Angel. Native to high-frequency celestial spheres, pristine marble sanctuaries, and ordered sanctums.", "They view physical fitness, structural balance, and inner peace as sacred forms of self-improvement.", "Luminous Celestial Radiance: High-frequency aura requires ambient light and celestial energy. Pitch-black void darkness causes aura fading, physical lethargy, and vocal dissonance.", "Pure Saline Ambrosia: Celestial digestion thrives on pure nectar, saline ambrosia, and clean nutrients; greasy fast food causes stomach revulsion and wing droop.", "Harmonic Frequency Resonance: Vocal cords produce overlapping multi-harmonic chords. Resonates with metallic chime undertones when calm, shifting to low hums when flustered.", "Weightless Levitation: Wings and light aura keep him hovering slightly above ground when relaxed, preventing heavy foot calluses or foot fatigue.", "Vector Ocular Scanning: Dozens of ocular eyes in his head-cluster scan ambient light and room layout in real-time to ensure optimal comfort.", "Golden-Ratio Tactile Tracing: Under stress or affection, fingers subconsciously trace smooth circles and parallel lines across surfaces.")
min_affection_for_match = 80
