[resource]
script = ExtResource("1_monster")
id = "vampire"
display_name = "Percival"
species = "Vampire"
dialogue_resource = ExtResource("2_dialogue")
dialogue_voice = ExtResource("3_voice")
species_lore = PackedStringArray("Sanguine Nocturnal / Vampirus Aristocratis. Native to ancestral gothic manors, subterranean mausoleums, and pitch-black keeps.", "They view existence through blood nobility and sensory perfection. Blood is regarded as a delicate vintage recording memory and vital essence.", "Hematophagous diet: consumes blood exclusively. Extremely snobbish about vintage, plasma balance, and warmth. Sub-normal body temperature (15 to 18°C).", "Actinic Photophobia: Direct UV light triggers skin necrosis and disorientation. Even 6 AM dawn glow causes involuntary squinting and weakness.", "Sub-Epidermal Pulse Perception: Tracks surrounding heartbeats within a 5-meter radius, subconsciously detecting suitor nervousness.", "The Mirror Anomaly: Zero reflection in silver-backed mirrors; displays an involuntary head tilt or micro-hesitation near silver glass.", "Hematotrophic Pupil Lock: Scent of fresh blood or intimacy causes immediate pupil dilation and involuntary fang extension.", "Strict Nocturnal Circadian Lock: Biological sleep cycle hard-coded sunrise to dusk. Enjoying morning sunrises is physically impossible.")
min_affection_for_match = 80
