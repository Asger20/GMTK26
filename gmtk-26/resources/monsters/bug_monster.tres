dialogue_voice = ExtResource("8_voice")
species_lore = PackedStringArray("Arachneoid Sapiens / Spider Folk. Native to pitch-black subterranean caverns and high-altitude spires.", "They view the universe through structural geometry (tension, balance, devotion). Silk spinning is a sacred high art form.", "Silk production requires raw meat, dense amino acids, and heavy hydration. Excessive spinning without food causes severe abdominal cramping and physical fatigue.", "Epidermal sensory hairs (Trichobothria) continuously detect subtle air currents, humidity shifts, and micro-vibrations.", "Cold-blooded metabolism. Sudden heat sources or dry warmth dry out internal silk glands, triggering lethargy and motor sluggishness.", "The Vibration Reflex: Sudden mechanical vibrations trigger an involuntary twitch and dead-lock gaze toward the source.", "Nervous Weaving: Under stress, excitement, or attraction, fingers subconsciously spin, twist, and anchor fine silk threads onto nearby objects.", "Courtship & Cannibalism: Insulting or failing an Arachneoid during intimacy triggers an uncontrollable biological instinct to paralyze, cocoon, and preserve the mate for later consumption.")
min_affection_for_match = 80
