[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/custom_balloon.gd" id="1_balloon"]
[ext_resource type="Script" path="res://addons/dialogue_manager/dialogue_label.gd" id="2_label"]
[ext_resource type="Script" path="res://addons/dialogue_manager/dialogue_responses_menu.gd" id="3_menu"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_unified_box"]
bg_color = Color(0.12, 0.1, 0.08, 1)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.8, 0.62, 0.22, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
shadow_color = Color(0, 0, 0, 0.75)
shadow_size = 14

[node name="CustomBalloon" type="CanvasLayer"]
layer = 5
script = ExtResource("1_balloon")

[node name="Balloon" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="DialogueBox" type="Panel" parent="Balloon"]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -340.0
offset_top = -210.0
offset_right = 340.0
offset_bottom = -25.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 1
theme_override_styles/panel = SubResource("StyleBoxFlat_unified_box")

[node name="Margin" type="MarginContainer" parent="Balloon/DialogueBox"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = 15.0
offset_right = -20.0
offset_bottom = -15.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="SpeechContainer" type="VBoxContainer" parent="Balloon/DialogueBox/Margin"]
layout_mode = 2
mouse_filter = 1

[node name="CharacterLabel" type="RichTextLabel" parent="Balloon/DialogueBox/Margin/SpeechContainer"]
layout_mode = 2
mouse_filter = 1
theme_override_font_sizes/normal_font_size = 18
bbcode_enabled = true
text = "[b][color=#e6b800]Monster[/color][/b]"
fit_content = true

[node name="DialogueLabel" type="RichTextLabel" parent="Balloon/DialogueBox/Margin/SpeechContainer"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 1
theme_override_colors/default_color = Color(0.94, 0.88, 0.72, 1)
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
script = ExtResource("2_label")


[node name="ContinuePrompt" type="Label" parent="Balloon/DialogueBox/Margin/SpeechContainer"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.6, 0.4, 1)
theme_override_font_sizes/font_size = 13
text = "[ CLICK ANYWHERE TO CONTINUE ▶ ]"
horizontal_alignment = 2

[node name="ResponsesContainer" type="VBoxContainer" parent="Balloon/DialogueBox/Margin"]
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="ChoiceHeader" type="Label" parent="Balloon/DialogueBox/Margin/ResponsesContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.62, 0.22, 1)
theme_override_font_sizes/font_size = 14
text = "YOUR RESPONSE (SELECT AN OPTION):"

[node name="ResponsesMenu" type="VBoxContainer" parent="Balloon/DialogueBox/Margin/ResponsesContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6
script = ExtResource("3_menu")
